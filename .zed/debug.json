// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Run Tests",
    "adapter": "Delve",
    "request": "launch",
    "mode": "test",
    "program": "${ZED_WORKTREE_ROOT}/test",
    "buildFlags": [],
    "cwd": "${ZED_WORKTREE_ROOT}/test",
    "envFile": "${ZED_WORKTREE_ROOT}/.env",
    // To filter down to just the test your cursor is in:
    "args": ["-test.v"], //["-test.run", "$ZED_SYMBOL"]
  },
  {
    "label": "Emit parse tree",
    "adapter": "Delve",
    "request": "launch",
    "mode": "debug",
    "program": "${ZED_WORKTREE_ROOT}/src/ui/cli/main/main.go",
    "buildFlags": [],
    "cwd": "${ZED_WORKTREE_ROOT}",
    "envFile": "${ZED_WORKTREE_ROOT}/.env",
    "args": [
      "emit",
      "--in=DATASETS/2025_M2_TCS/q/5/*.json",
      "--out=DATASETS/output/2025M2TCS/q5",
    ],
  },
  {
    "label": "Emit DOT",
    "adapter": "Delve",
    "request": "launch",
    "mode": "debug",
    "program": "${ZED_WORKTREE_ROOT}/src/ui/cli/main/main.go",
    "buildFlags": [],
    "cwd": "${ZED_WORKTREE_ROOT}",
    "envFile": "${ZED_WORKTREE_ROOT}/.env",
    "args": [
      "emit",
      "--in=DATASETS/2025_M2_BIT/q/1/121464.json",
      "--out=./",
      "--type=dot",
    ],
  },
  {
    "label": "Grade DATASET 2024 BIT",
    "adapter": "Delve",
    "request": "launch",
    "mode": "debug",
    "program": "${ZED_WORKTREE_ROOT}/src/ui/cli/main/main.go",
    "buildFlags": [],
    "cwd": "${ZED_WORKTREE_ROOT}",
    "envFile": "${ZED_WORKTREE_ROOT}/.env",
    "args": [
      "grade",
      "--in=DATASETS/2025_M2_BIT/q/1/121464.json",
      "--out=./",
      "--type=dot",
    ],
  },
]
